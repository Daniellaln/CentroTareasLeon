      "css": ".ds-process{padding:8px 0;font-family:sans-serif;color:#132A44}.ds-process-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-process-head strong{font-size:16px;font-weight:600;line-height:24px;letter-spacing:.2px}.ds-process-head span{color:#195DAA;font-size:14px;font-weight:500;line-height:20px}.ds-process-track{display:block;width:100%;height:28px;margin:6px 0}.ds-process-track path{fill:none;stroke-width:4;stroke-linecap:round}.ds-process small{display:block;color:#475F7A;font-size:12px;line-height:16px;letter-spacing:.4px}"
    }
