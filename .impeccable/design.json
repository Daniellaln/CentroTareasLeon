      "html": "<div class=\"ds-dial\" role=\"progressbar\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"42\"><svg viewBox=\"0 0 180 180\" aria-hidden=\"true\"><circle class=\"ds-dial-ticks\" cx=\"90\" cy=\"90\" r=\"79\"/><circle class=\"ds-dial-track\" cx=\"90\" cy=\"90\" r=\"63\"/><circle class=\"ds-dial-value\" cx=\"90\" cy=\"90\" r=\"63\"/></svg><span>42 %</span></div>",
      "css": ".ds-dial{position:relative;width:180px;height:180px;color:#195DAA;font:400 45px/52px sans-serif}.ds-dial svg{width:100%;height:100%;transform:rotate(-90deg)}.ds-dial circle{fill:none}.ds-dial-ticks{stroke:#D3DEEB;stroke-width:5;stroke-dasharray:2 2.964}.ds-dial-track{stroke:#D3DEEB;stroke-width:6}.ds-dial-value{stroke:#195DAA;stroke-width:6;stroke-linecap:round;stroke-dasharray:166.25 395.84}.ds-dial span{position:absolute;inset:0;display:grid;place-items:center}"
    },
